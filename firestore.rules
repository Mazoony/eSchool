rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'wadareaf@gmail.com';
    }

    function ownsProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function usernameReservedByCaller(username) {
      return username == null
        || (
          username is string
          && username.matches('^[a-z0-9_]{3,20}$')
          &&
          existsAfter(/databases/$(database)/documents/usernames/$(username))
          && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid
        );
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if ownsProfile(uid)
        && request.resource.data.keys().hasOnly([
          'username', 'full_name', 'avatar_url', 'bio', 'created_at', 'updated_at'
        ])
        && usernameReservedByCaller(request.resource.data.username);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if ownsProfile(request.resource.data.uid)
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if ownsProfile(resource.data.uid)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if ownsProfile(resource.data.uid);
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;

      match /likes/{uid} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.user_id == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn()
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.user_id == request.auth.uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000;
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.user_id == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.user_id == request.auth.uid);

        match /likes/{uid} {
          allow read: if true;
          allow create: if signedIn()
            && request.auth.uid == uid
            && request.resource.data.user_id == request.auth.uid;
          allow update: if false;
          allow delete: if signedIn()
            && (request.auth.uid == uid
              || get(/databases/$(database)/documents/posts/$(postId)).data.user_id == request.auth.uid
              || get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.user_id == request.auth.uid);
        }
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipient_user_id == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.sender_user_id == request.auth.uid
        && request.resource.data.recipient_user_id != request.auth.uid
        && request.resource.data.type in ['like', 'comment', 'like_comment', 'reply'];
      allow update: if signedIn()
        && resource.data.recipient_user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read'])
        && request.resource.data.is_read == true;
      allow delete: if false;
    }
  }
}
